# -----------------------------------------------------------------------------
# agent-demo/.env.template
# -----------------------------------------------------------------------------
# Documentation-only template. Never committed with real values. The actual
# environment is populated by ./scripts/Bootstrap-Env.ps1 which reads
# `terraform output -json` from the repo root and calls `azd env set` for each
# variable below. Values reappear via `azd env get-values`.
#
# Every AGENT_FEATURE_* flag defaults to true if not set. To disable a
# capability at deploy time, set it to false and run `azd deploy` again:
#   azd env set AGENT_FEATURE_KB_SEARCH false
#   azd deploy
#
# The container image never sees this file - values are injected as environment
# variables by the Foundry Agent Service runtime, sourced from the azd env.
# -----------------------------------------------------------------------------

# ---- Azure identity / resource context (populated by Bootstrap-Env.ps1) -----
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=swedencentral
AZURE_RESOURCE_GROUP=

# ---- Foundry ---------------------------------------------------------------
AZURE_AI_ACCOUNT_NAME=
AZURE_AI_PROJECT_NAME=
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_ACCOUNT_ENDPOINT=
AZURE_AI_CHAT_DEPLOYMENT=gpt-5
AZURE_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ---- Container registry (target for the azd remote build) ----------------
# `azd deploy` uses `docker.remoteBuild: true` (see azure.yaml) to run an
# ACR remote build; this is the registry it pushes the demo-agent image to.
AZURE_CONTAINER_REGISTRY_NAME=

# ---- Cosmos DB (memory tool) -----------------------------------------------
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=demo
AZURE_COSMOS_MEMORY_CONTAINER=memory

# ---- AI Search (KB tool) ---------------------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=demo-kb

# ---- Storage (blob + files tools) ------------------------------------------
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_BLOB_ENDPOINT=
AZURE_STORAGE_FILE_ENDPOINT=
AZURE_STORAGE_DEMO_CONTAINER=demo-data
AZURE_STORAGE_DEMO_SHARE=demo-share

# ---- Key Vault (secret tool) -----------------------------------------------
AZURE_KEY_VAULT_URI=
AZURE_KV_DEMO_SECRET_NAME=demo-flag

# ---- Application Insights (tracing) ----------------------------------------
# Wired via the appinsightsconn project connection; the Foundry runtime also
# injects this automatically. Present here for local development.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Feature toggles (all default true if unset) ---------------------------
AGENT_FEATURE_TRACING=true
AGENT_FEATURE_HEALTHCHECK=true
AGENT_FEATURE_MEMORY_COSMOS=true
AGENT_FEATURE_KB_SEARCH=true
AGENT_FEATURE_BLOB=true
AGENT_FEATURE_KV_SECRET=true
AGENT_FEATURE_SMB_FILES=true
AGENT_FEATURE_CHAT_GPT5=true

# ---- First-run in-container seeding ----------------------------------------
# When true (default), src/bootstrap.py runs on container startup:
#   - creates AI Search index `demo-kb` if missing
#   - embeds & uploads bundled KB docs
#   - uploads a sample text blob to `demo-data`
#   - writes a hello file to `demo-share`
# Idempotent: writes a marker blob (`demo-data/.seeded`) so repeat boots no-op.
AGENT_SEED_ON_STARTUP=true

# ---- Image (populated by `azd deploy` after the ACR remote build) ---------
# NOT edited by hand. The `azure.ai.agent` service target builds the image
# server-side (docker.remoteBuild: true), writes the resulting tag here, and
# then hands it to the Foundry runtime as the hosted agent's container image.
AGENT_IMAGE_URI=
